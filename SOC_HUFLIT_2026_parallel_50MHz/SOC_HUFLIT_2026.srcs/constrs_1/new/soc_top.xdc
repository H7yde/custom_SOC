################################################################################
# PYNQ-Z2 pin map for the 16-bit full-duplex DDR stream and SoC peripherals.
# Board reference: 125 MHz oscillator H16; SW0 reset M20.
################################################################################
set_property -dict {PACKAGE_PIN H16 IOSTANDARD LVCMOS33} [get_ports clk]
set_property -dict {PACKAGE_PIN M20 IOSTANDARD LVCMOS33} [get_ports resetn]
# H16 drives the SoC directly at 125 MHz through a BUFG.
create_clock -name clk_125m -period 8.000 -waveform {0.000 4.000} [get_ports clk]

# The forwarded DDR clock is generated by the serializer ODDR from its MMCM clock.
create_generated_clock -name ddr_clk_out \
    -source [get_pins {u_parallel_axi/u_ddr_result_serializer/u_oddr_clk/C}] \
    -divide_by 1 -invert [get_ports ddr_clk_out]

# 16-bit DDR receive bus on Pmod JA/JB.
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[0]}]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[1]}]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[2]}]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[3]}]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[4]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[5]}]
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[6]}]
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[7]}]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[8]}]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[9]}]
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[10]}]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[11]}]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[12]}]
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[13]}]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[14]}]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33} [get_ports {ddr_data_in[15]}]

# 16-bit DDR transmit bus on Arduino digital 0-13 and analog A0-A1.
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33} [get_ports {ddr_data[0]}]
set_property -dict {PACKAGE_PIN U12 IOSTANDARD LVCMOS33} [get_ports {ddr_data[1]}]
set_property -dict {PACKAGE_PIN U13 IOSTANDARD LVCMOS33} [get_ports {ddr_data[2]}]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33} [get_ports {ddr_data[3]}]
set_property -dict {PACKAGE_PIN V15 IOSTANDARD LVCMOS33} [get_ports {ddr_data[4]}]
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33} [get_ports {ddr_data[5]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33} [get_ports {ddr_data[6]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {ddr_data[7]}]
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports {ddr_data[8]}]
set_property -dict {PACKAGE_PIN V18 IOSTANDARD LVCMOS33} [get_ports {ddr_data[9]}]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33} [get_ports {ddr_data[10]}]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33} [get_ports {ddr_data[11]}]
set_property -dict {PACKAGE_PIN P18 IOSTANDARD LVCMOS33} [get_ports {ddr_data[12]}]
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports {ddr_data[13]}]
set_property -dict {PACKAGE_PIN Y11 IOSTANDARD LVCMOS33} [get_ports {ddr_data[14]}]
set_property -dict {PACKAGE_PIN Y12 IOSTANDARD LVCMOS33} [get_ports {ddr_data[15]}]

# Receive valid on Arduino analog A2; forwarded clock and status on RPi GPIO.
set_property -dict {PACKAGE_PIN W11 IOSTANDARD LVCMOS33} [get_ports ddr_rx_valid]
set_property -dict {PACKAGE_PIN V10 IOSTANDARD LVCMOS33} [get_ports ddr_clk_out]
set_property -dict {PACKAGE_PIN V8 IOSTANDARD LVCMOS33} [get_ports ddr_valid]
set_property -dict {PACKAGE_PIN W10 IOSTANDARD LVCMOS33} [get_ports ddr_done]

# UART on the RPi UART header pins.
set_property -dict {PACKAGE_PIN Y9 IOSTANDARD LVCMOS33} [get_ports uart_tx]
set_property -dict {PACKAGE_PIN A20 IOSTANDARD LVCMOS33} [get_ports uart_rx]

# SPI on the Arduino SPI pins.
set_property -dict {PACKAGE_PIN H15 IOSTANDARD LVCMOS33} [get_ports spi_sclk]
set_property -dict {PACKAGE_PIN T12 IOSTANDARD LVCMOS33} [get_ports spi_mosi]
set_property -dict {PACKAGE_PIN W15 IOSTANDARD LVCMOS33} [get_ports spi_miso]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports spi_cs]

# I2C on the Arduino I2C pins; SDA is a tri-state bidirectional port.
set_property -dict {PACKAGE_PIN P16 IOSTANDARD LVCMOS33} [get_ports scl_out]
set_property -dict {PACKAGE_PIN P15 IOSTANDARD LVCMOS33} [get_ports sda]

set_property IOB TRUE [get_cells -hierarchical -filter {NAME =~ *u_ddr_result_serializer/ddr_valid_reg}]

# External receiver timing is unspecified. Add input/output delays when the
# connected device and board-level timing are known.
